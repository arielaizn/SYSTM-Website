5:["$","$L1a",null,{"value":{"source":"defaults","settings":{"phone":"+972534122548","phoneDisplay":"053-412-2548","whatsapp":"972534122548","email":"","description":"סוכני AI, אוטומציות והדרכות מעשיות לעסקים. מתכננים, מחברים ומטמיעים מערכות שמתאימות לעבודה שלכם.","socials":[],"banner":{"enabled":false,"text":"","href":""}},"services":[{"slug":"ai-agents","diagram":"ai-agents","number":"01","label":"סוכני AI","short":"תפקיד אחד, הרשאות מוגדרות, אישור לפני כל פעולה רגישה.","title":"עוד זוג ידיים בצוות. עם הרשאות מוגדרות.","intro":"סוכן AI מקבל תפקיד אחד ברור, כלים מוגדרים וגבולות. הוא עונה לפניות, מכין טיוטות ומקדם משימות. כל פעולה רגישה עוברת לאישור שלכם.","meta":"תכנון והטמעה של סוכני AI לעסקים: תפקיד כתוב, חיבור למקורות המידע שלכם, הרשאות ונקודות אישור.","items":["תפקיד כתוב: מה הסוכן עושה ומה אסור לו לעשות","חיבור למקורות המידע שלכם: מסמכים, גיליונות, מערכות ותיבת מייל","הרשאות ונקודות אישור: מי מאשר מה, ומתי הסוכן עוצר","בדיקה על פניות אמיתיות, כולל המקרים המוזרים"],"example":["פנייה נכנסת","איסוף פרטים","סיווג הבקשה","טיוטת תשובה","אישור אנושי"],"fit":"עסקים שעונים לאותן שאלות כל יום, או שהידע שלהם מפוזר בין מסמכים ואנשים.","outcome":"סוכן שעובד לפי תפקיד כתוב, יומן פעולות שאפשר לקרוא ודרך ברורה לעצור אותו.","faqs":[["הסוכן שולח הודעות ללקוחות בעצמו?","רק אם החלטתם על זה. ברירת המחדל היא טיוטה שאדם מאשר, ואפשר להרחיב את ההרשאה בהדרגה, אחרי שרואים איך הוא מתנהג."],["מה קורה כשהסוכן לא יודע את התשובה?","כותבים מראש מה הוא עושה במצב כזה: שואל שאלה, מעביר לאדם או עוצר. תשובה מנוחשת לא נחשבת אפשרות."]]},{"slug":"automation","diagram":"automation","number":"02","label":"אוטומציות לעסקים","short":"הטופס, ההודעה, הגיליון והמערכת עובדים ברצף, עם התראה כשמשהו נתקע.","title":"הכלים שלכם כבר קיימים. נחבר ביניהם.","intro":"הטופס, ההודעה, הגיליון והמערכת מדברים כל אחד בשפה אחרת, ומישהו מעתיק ביניהם. אנחנו בונים את החיבורים האלה, עם התראה כשמשהו נתקע.","meta":"אוטומציות לעסקים: חיבור בין טפסים, הודעות, גיליונות ומערכות, עם טיפול בשגיאות ותיעוד.","items":["מיפוי התהליך כמו שהוא קורה בפועל, כולל החריגים","חיבור בין מערכות דרך ממשקים שקיימים","טיפול בשגיאות: התראה, ניסיון חוזר והעברה לאדם","תיעוד קצר שמסביר מה רץ ואיפה"],"example":["ליד חדש","בדיקת פרטים","עדכון המערכת","משימה לנציג","הודעת מעקב"],"fit":"עסקים שמעבירים את אותו מידע בין כמה כלים, כל יום.","outcome":"תהליך שרץ לבד, עם נקודות בקרה ודרך לטפל בתקלות.","faqs":[["אפשר לחבר מערכת שאין לה ממשק?","לפעמים כן, בדרכים עוקפות. בשיחת המיפוי בודקים מה קיים בפועל ומה עדיף להחליף, לפני שמתחייבים לתהליך."],["מה קורה כשאוטומציה נכשלת באמצע?","התהליך עוצר, נשלחת התראה למי שהגדרתם, ואפשר להריץ שוב מהשלב שנתקע. כל זה נקבע לפני שמפעילים."]]},{"slug":"consulting","diagram":"consulting","number":"03","label":"ייעוץ והטמעה","short":"מיפוי, סדר עדיפויות ופיילוט אחד עם קריטריון הצלחה.","title":"קודם מבינים מה לבנות. אחר כך בונים.","intro":"מתחילים מהעבודה שלכם: מה חוזר, מה מעכב ומה עולה הכי הרבה זמן. משם בוחרים תהליך אחד לפיילוט, עם קריטריון הצלחה שנקבע מראש.","meta":"ייעוץ והטמעת AI בעסק: מיפוי תהליכים, סדר עדיפויות ותכנון פיילוט עם קריטריוני הצלחה.","items":["שיחת מיפוי על העסק והמטרות","רשימת תהליכים לפי השפעה ומאמץ","תכנון פיילוט: בעלים, מדדים ומתי עוצרים","ליווי בהטמעה ובדיקת התוצאה"],"example":["מיפוי","בחירת תהליך","פיילוט ממוקד","בדיקת תוצאה","החלטה"],"fit":"בעלי עסקים ומנהלים שרוצים כיוון לפני שמשקיעים בפיתוח.","outcome":"תוכנית פעולה שמחברת בעיה אמיתית בעסק לפתרון שאפשר לבדוק.","faqs":[["צריך להכין משהו לפני שיחת המיפוי?","לא. מספיק לדעת מה מפריע בעבודה. אם יש לכם דוגמאות, כמו טופס, גיליון או שרשור הודעות, הן יעזרו."],["כמה זמן נמשך פיילוט?","זה נקבע לפי התהליך, ולא לפי תבנית. בסוף המיפוי מקבלים לוח זמנים ואבני דרך לפיילוט הספציפי."]]},{"slug":"workshops","diagram":"workshops","number":"04","label":"הרצאות וסדנאות","short":"מפגש מעשי שמתחיל מהמשימות של הצוות.","title":"לומדים על המשימות של הצוות שלכם.","intro":"מפגש מעשי שמתחיל ממה שהצוות עושה ביום־יום. רואים דוגמה, מתנסים, ויוצאים עם רשימת שימושים שאפשר להתחיל לבדוק כבר השבוע.","meta":"הרצאות וסדנאות AI לצוותים וארגונים: תרגול על משימות אמיתיות, בשפה פשוטה.","items":["התאמת התוכן לקהל ולתפקידים","דוגמאות מהתחום שלכם","תרגול על משימות אמיתיות של המשתתפים","חומרי המשך ורעיונות ליישום"],"example":["מכירים יכולת","רואים דוגמה","מתנסים","בוחרים שימוש","ממשיכים לבד"],"fit":"צוותים, ארגונים ובעלי עסקים שרוצים להבין ולהתחיל ליישם.","outcome":"הבנה מעשית ורשימת שימושים לבדיקה.","faqs":[["צריך ידע קודם?","לא. רמת ההיכרות של הקבוצה קובעת איפה מתחילים, ואין צורך שמישהו יגיע עם ניסיון בכלים."],["אפשר להתאים את המפגש לתחום שלנו?","זה בדיוק הרעיון. לפני המפגש מבררים מה הצוות עושה ומתאימים את הדוגמאות והתרגילים."]]},{"slug":"claude-code","diagram":"claude-code","number":"05","label":"קלוד קוד ליוצרים","short":"הדרכה מעשית לעורכי וידאו ויוצרי תוכן.","title":"מרעיון לכלי שעובד בשבילך.","intro":"הדרכה על קלוד קוד ליוצרים ולעורכי וידאו. מנסחים משימה, עובדים עם קבצים ובונים כלים קטנים לתהליך היצירה, צעד אחר צעד.","meta":"הדרכה על קלוד קוד ליוצרים ולעורכי וידאו: ניסוח משימה, עבודה עם קבצים ובניית כלים לתהליך היצירה.","items":["היכרות והתקנה של סביבת העבודה","ניסוח משימה ותכנון לפני ביצוע","עבודה עם קבצים, כלים וחיבורים","יישום על תהליך אמיתי של תוכן או וידאו"],"example":["מגדירים צורך","מפרקים למשימות","בונים בצעדים","בודקים את התוצר"],"fit":"יוצרים ועורכים שרוצים להרחיב את מה שהם מסוגלים לבצע לבד.","outcome":"דרך עבודה ברורה ופרויקט מעשי שמחובר לצורך שלכם.","faqs":[["צריך לדעת לתכנת?","לא. עובדים בשפה רגילה, ומסבירים בדרך מה קורה מאחורי הקלעים כשזה עוזר."],["על איזה סוג עבודה זה מתאים?","על כל תהליך חוזר סביב תוכן, למשל סידור קבצים, הכנת חומרים או כלים קטנים לעריכה. בוחרים יחד משימה אחת מהעבודה שלכם."]]}],"articles":[{"slug":"first-automation","category":"אוטומציות","title":"איך בוחרים את האוטומציה הראשונה בעסק","summary":"תהליך אחד, עם התחלה, סוף ודרך למדוד. ככה מצמצמים רשימת רעיונות ארוכה לצעד ראשון.","read":"4 דקות קריאה","sections":[["עוברים על יום עבודה אחד","קחו את יום העבודה האחרון ורשמו כל מקום שבו העתקתם מידע בין כלים, חיפשתם קובץ או ענית על אותה שאלה בפעם השלישית. לא צריך רשימה ארוכה. מספיקים שלושה או ארבעה מקרים אמיתיים, ולכל אחד: מי עושה אותו, באיזה כלי הוא מתחיל ואיך הוא נגמר."],["מגדירים התחלה וסוף","\"לשפר את השירות\" הוא יעד. \"לפתוח משימה בכל פעם שמגיעה פנייה עם כל השדות\" הוא תהליך. כתבו איזה אירוע מתחיל אותו, איזה מידע הוא צריך ומה הפעולה האחרונה. אם אי אפשר לכתוב את זה בשלוש שורות, התהליך עדיין גדול מדי."],["מחפשים את החריגים לפני שבונים","מה קורה כשחסר טלפון? כשאותו ליד נכנס פעמיים? כשהמערכת השנייה לא עונה? את התשובות אוספים לפני הבנייה, כי שם נשברות רוב האוטומציות. חלק מהחריגים אפשר לטפל אוטומטית, וחלק עוברים לאדם. מותר להחליט על כל אחד אחרת."],["בוחרים מדד אחד","זמן טיפול בפנייה, או מספר ההעתקות הידניות. מודדים שבוע לפני שמתחילים, ואז משווים. אל תבטיחו חיסכון שעוד לא נמדד. השוואה קטנה ואמינה שווה יותר ממספר גדול שאי אפשר להסביר."],["מתחילים על חלק קטן ומשאירים דרך חזרה","אפשר להריץ על עשר הפניות הראשונות ביום, או לבקש אישור לפני כל פעולה שיוצאת מהעסק. קובעים מי מקבל התראה ומי יכול לעצור. אחרי שבוע בודקים, ורק אז מרחיבים."]]},{"slug":"agent-vs-automation","category":"סוכני AI","title":"סוכן AI או אוטומציה: מה מתאים לתהליך שלכם","summary":"ההחלטה תלויה בכמה שינוי יש במשימה ובכמה שיקול דעת היא דורשת, ופחות בשם הכלי.","read":"4 דקות קריאה","sections":[["כשיש כלל ברור, כותבים כלל","אם בכל פעם שטופס מגיע תקין צריך ליצור רשומה ולעדכן אחראי, אין סיבה להכניס מודל שפה. כלל קבוע זול יותר, מהיר יותר, ואפשר לצפות מראש מה הוא יעשה."],["כשהמידע משתנה צריך פירוש","פנייה בטקסט חופשי, מסמך סרוק או שאלה בניסוח לא צפוי דורשים הבנה של הקשר. כאן יש מקום למודל. מגדירים מה מותר לו להסיק, ממה הוא קורא ומה הוא עושה כשאין לו תשובה טובה."],["אפשר לשלב","הרבה פעמים המבנה הנכון הוא תהליך קבוע עם משימה אחת מוגדרת בתוכו ל־AI: לסכם פנייה, להציע סיווג, להכין טיוטה. ההפעלה, השמירה וההתראות נשארות כללים רגילים. ככה החלק הלא צפוי נשאר קטן."],["גבולות לפני יכולות","לפני שמרשים למערכת לשלוח, למחוק או לשנות, קובעים הרשאות ונקודות אישור, ודרך לזהות טעות ולהעביר לאדם. שואלים כמה עולה טעות אחת, ואם אפשר לבדוק את התוצאה."],["מריצים ניסוי קטן","אוספים עשר דוגמאות אמיתיות, כולל הלא נוחות, ובודקים. אחר כך שואלים כמה עולה לתחזק את זה. בוחרים את הדרך הפשוטה ביותר שנותנת תוצאה שאפשר לסמוך עליה."]]},{"slug":"ai-pilot","category":"הטמעה","title":"מה מגדירים לפני פיילוט AI","summary":"בעיה אחת, אחראי אחד ומדד שנקבע מראש. ואז אפשר להחליט בסוף מה לעשות הלאה.","read":"5 דקות קריאה","sections":[["בוחרים תהליך אחד","פיילוט עונה על שאלה אחת. בחרו משימה שיש לה בעלים בעסק, מידע זמין והגדרה ברורה של \"עשינו אותה נכון\". עדיף ללמוד לעומק על תהליך קטן מאשר להפעיל הדגמה רחבה שאף אחד לא משתמש בה."],["קובעים מי אחראי על מה","מי נותן דוגמאות, מי בודק את התשובות, מי מאשר חיבור למערכת. כותבים את זה לפני שמתחילים. אם יש מידע שלא יוצא מהעסק, כותבים גם את זה, ואילו שירותים מותר לחבר."],["מגדירים הצלחה, ומגדירים עצירה","הצלחה יכולה להיות רמת דיוק שהסכמתם עליה, זמן טיפול קצר יותר או פחות פעולות ידניות. ולצדה מתי עוצרים: פעולה שלא הותרה, מידע חסר או סטייה שחוזרת. בלי שני הצדדים קשה להחליט בסוף."],["נותנים לאנשים להשתמש","מערכת יכולה לעבור בדיקה ועדיין להיות לא נוחה לצוות. תנו למי שמבצע את התהליך לעבוד איתה כמה ימים. שאלו מה לא ברור, מה צריך בדיקה חוזרת ומתי הם חוזרים לכלי הקודם. זה חלק מהפיילוט."],["כותבים החלטה","בסוף עמוד אחד: מה עבד, מה לא ומה עוד לא ידוע. מרחיבים, משנים כיוון או עוצרים. כל אחת מהאפשרויות היא תוצאה טובה כשהיא מבוססת על משהו שנבדק."]]}],"faqs":[["צריך להבין בתכנות כדי לעבוד איתכם?","לא. מתחילים מהעבודה שלכם ומהמטרה, ואת החלק הטכני מסבירים בשפה רגילה."],["איך בוחרים מה לאוטמט קודם?","תהליך שחוזר הרבה, לוקח זמן, ויש לו התחלה, סוף ודרך לבדוק שהצליח. בשיחת המיפוי עוברים גם על החריגים ועל ההרשאות."],["אפשר להתחיל מפרויקט קטן?","כן, וזה בדרך כלל הכי נכון. פיילוט על תהליך אחד בודק את הכיוון לפני שמרחיבים. ההיקף והמחיר נקבעים אחרי שמבינים מה צריך."],["הסוכן יכול לעשות הכול לבד?","רק מה שהגדרתם לו. פעולות רגישות, כמו שליחה ללקוח או שינוי נתונים, עוברות לאישור אנושי, ותמיד יש דרך לעצור."],["מה קורה עם המידע של העסק?","כותבים מראש איזה מידע הסוכן רואה ולאילו שירותים הוא מתחבר. מידע שלא אמור לצאת מהעסק לא מחברים."],["כמה זמן לוקחת הטמעה?","זה תלוי במערכות, בהיקף התהליך ובזמינות של המידע והצוות. אחרי המיפוי מקבלים אבני דרך ולוח זמנים לפרויקט שלכם."]],"contactChoices":[{"value":"ai-agents","label":"סוכני AI"},{"value":"automation","label":"אוטומציות לעסקים"},{"value":"consulting","label":"ייעוץ והטמעה"},{"value":"workshops","label":"הרצאות וסדנאות"},{"value":"claude-code","label":"קלוד קוד ליוצרים"},{"value":"not-sure","label":"רוצה להבין מה מתאים לי"}]},"children":["$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}]
