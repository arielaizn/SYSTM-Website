4:T944,[{"@context":"https://schema.org","@type":"Organization","name":"SYSTM","description":"סוכני AI, אוטומציות והדרכות מעשיות לעסקים. מתכננים, מחברים ומטמיעים מערכות שמתאימות לעבודה שלכם.","founder":{"@type":"Person","name":"אריאל יהודה איזנשטט"},"telephone":"+972534122548"},{"@context":"https://schema.org","@type":"WebSite","name":"SYSTM","inLanguage":"he-IL"},{"@context":"https://schema.org","@type":"FAQPage","inLanguage":"he-IL","mainEntity":[{"@type":"Question","name":"צריך להבין בתכנות כדי לעבוד איתכם?","acceptedAnswer":{"@type":"Answer","text":"לא. מתחילים מהעבודה שלכם ומהמטרה, ואת החלק הטכני מסבירים בשפה רגילה."}},{"@type":"Question","name":"איך בוחרים מה לאוטמט קודם?","acceptedAnswer":{"@type":"Answer","text":"תהליך שחוזר הרבה, לוקח זמן, ויש לו התחלה, סוף ודרך לבדוק שהצליח. בשיחת המיפוי עוברים גם על החריגים ועל ההרשאות."}},{"@type":"Question","name":"אפשר להתחיל מפרויקט קטן?","acceptedAnswer":{"@type":"Answer","text":"כן, וזה בדרך כלל הכי נכון. פיילוט על תהליך אחד בודק את הכיוון לפני שמרחיבים. ההיקף והמחיר נקבעים אחרי שמבינים מה צריך."}},{"@type":"Question","name":"הסוכן יכול לעשות הכול לבד?","acceptedAnswer":{"@type":"Answer","text":"רק מה שהגדרתם לו. פעולות רגישות, כמו שליחה ללקוח או שינוי נתונים, עוברות לאישור אנושי, ותמיד יש דרך לעצור."}},{"@type":"Question","name":"מה קורה עם המידע של העסק?","acceptedAnswer":{"@type":"Answer","text":"כותבים מראש איזה מידע הסוכן רואה ולאילו שירותים הוא מתחבר. מידע שלא אמור לצאת מהעסק לא מחברים."}},{"@type":"Question","name":"כמה זמן לוקחת הטמעה?","acceptedAnswer":{"@type":"Answer","text":"זה תלוי במערכות, בהיקף התהליך ובזמינות של המידע והצוות. אחרי המיפוי מקבלים אבני דרך ולוח זמנים לפרויקט שלכם."}}]}]1a:X
