# Final domain including https, no trailing slash. While empty the site ships noindex + a robots.txt that blocks crawling.
NEXT_PUBLIC_SITE_URL=
# "whatsapp" (default): the form prepares a WhatsApp message and nothing is sent until the visitor sends it.
# "webhook": the form POSTs to /api/leads, which forwards to LEAD_WEBHOOK_URL. Update the privacy page before switching.
NEXT_PUBLIC_CONTACT_MODE=whatsapp
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Exact site origin allowed to call /api/leads, e.g. https://example.co.il
# One exact origin, or several separated by commas: https://www.example.co.il,https://project.vercel.app
ALLOWED_ORIGIN=

# --- Admin (/admin) -----------------------------------------------------------------------------------
# Convex deployment URL, for example https://happy-animal-123.convex.cloud
CONVEX_URL=
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The SAME value must be set inside Convex: npx convex env set ADMIN_API_KEY <value>   (use --prod for production)
ADMIN_API_KEY=
# 32+ random characters, used to sign the login cookie. Server only.
ADMIN_SESSION_SECRET=
# Password hash. Generate: npm run admin:hash -- "your password"
# In .env files escape each $ as \$ . On Vercel paste the value as is.
ADMIN_PASSWORD_HASH=

# Push notifications for new leads (optional). Generate a pair: npx web-push generate-vapid-keys
# The public key is also exposed to the browser (it is meant to be public); keep the private key server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# IndexNow (optional): tells Bing and Yandex about new pages immediately. 8-128 chars, letters, digits and dashes.
# The key is served at /api/indexnow. Then use "קידום SEO" in /admin to submit all URLs.
INDEXNOW_KEY=
